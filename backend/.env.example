# Core Application Settings
PROJECT_NAME="Attendance Approval System"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-change-this-in-production-attendance-system"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL ONLY)
# Format: postgresql+asyncpg://USERNAME:PASSWORD@localhost:5432/attendance_approval
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/attendance_approval"

# Supabase Storage Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"
SUPABASE_BUCKET="attendance-documents"

# Environment
ENVIRONMENT="development"
